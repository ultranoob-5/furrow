.pio
.vscode/

# Firebase CLI's own local deploy cache - regenerated automatically,
# machine-specific, nothing worth tracking here.
.firebase/

# Real credentials live here locally only - never committed.
# See include/secrets.example.h for the template.
include/secrets.h

# Same reasoning, for the dashboard's Firebase config.
# See web/firebase-config.example.js for the template.
web/firebase-config.js

# Deployment-specific, not secret - but same reasoning: don't want the
# original project's ID baked into what a fork silently keeps using.
# See .firebaserc.example for the template.
.firebaserc

# The device account email is baked into these rules (see SETUP.md
# step 3) - same reasoning as .firebaserc above, not secret but
# deployment-specific. See database.rules.example.json for the
# template; `firebase deploy --only database` refuses to run at all
# if this file doesn't exist yet, rather than silently deploying
# nothing or falling back to the example's placeholder email.
database.rules.json

# Python bytecode cache from testing the power-watchdog script locally.
__pycache__/

# Cloud Functions dependencies - reinstalled from package.json/
# package-lock.json (both committed), never the actual node_modules.
functions/node_modules/
